# Supabase: Project Settings > API Keys. The publishable key is enough: every query
# runs as the logged-in user. The secret/service-role key is not used by this app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to use the app. Empty means nobody can.
# * means anyone with a confirmed account (each still sees only their own calls).
ALLOWED_EMAILS=

# LLM for /summary and /suggest. Only LLM_API_KEY is needed; it turns the LLM on.
# Free Groq key: console.groq.com -> API Keys. Leave empty to always use the
# fallback summary and static suggestions.
LLM_API_KEY=
# Optional, any OpenAI-compatible API. Defaults: Groq + openai/gpt-oss-20b.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Comma-separated exact origins. Add the literal *.vercel.app to allow Vercel preview URLs.
# http://localhost:5173 is allowed automatically unless NODE_ENV=production.
CORS_ORIGINS=https://your-app.vercel.app
NODE_ENV=development

PORT=3000

# Optional. If set, every route except /health and /stages needs header x-api-key.
API_KEY=
