# Copy to frontend/.env (next to package.json). Vite reads it only at startup:
# restart `npm run dev` after editing.

# Backend base URL, no trailing slash. Required unless VITE_USE_MOCK=true.
# Local backend: http://localhost:3000   Render: https://your-backend.onrender.com
VITE_API_URL=http://localhost:3000

# Supabase, for logging in. Project Settings > API Keys: the PUBLISHABLE key only.
# Never put the secret/service-role key here: everything in this file reaches the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Sent as the x-api-key header when set.
VITE_API_KEY=

# Optional. "true" runs on the in-memory mock API (offline demos, nothing is saved).
# Anything else (or unset) uses the real backend at VITE_API_URL.
VITE_USE_MOCK=
